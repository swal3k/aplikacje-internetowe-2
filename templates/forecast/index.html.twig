{% extends 'base.html.twig' %}

{% block title %}Forecast index{% endblock %}

{% block body %}
    <h1>Forecast index</h1>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Location</th>
                    <th>Date</th>
                    <th>Temperature_celsius</th>
                    <th>Humidity</th>
                    <th>Uv_index</th>
                    <th>Wind_speed</th>
                    <th>Precipitation</th>
                    <th>Pressure</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for forecast in forecasts %}
                <tr>
                    <td>{{ forecast.id }}</td>
                    <td>{{ forecast.location.city }}, {{ forecast.location.country }}</td>
                    <td>{{ forecast.date ? forecast.date|date('Y-m-d') : '' }}</td>
                    <td>{{ forecast.temperatureCelsius }}</td>
                    <td>{{ forecast.humidity }}</td>
                    <td>{{ forecast.uvIndex }}</td>
                    <td>{{ forecast.windSpeed }}</td>
                    <td>{{ forecast.precipitation }}</td>
                    <td>{{ forecast.pressure }}</td>
                    <td>
                        <a href="{{ path('app_forecast_show', {'id': forecast.id}) }}">show</a>
                        <a href="{{ path('app_forecast_edit', {'id': forecast.id}) }}">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="9">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_forecast_new') }}">Create new</a>
{% endblock %}
